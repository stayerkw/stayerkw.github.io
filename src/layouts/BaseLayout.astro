---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EnFooter from "../components/EnFooter.astro";
import { alternatesFor, isEnglishPath, nameEn } from "../data/i18n";
import Schema from "../components/Schema.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import type { WaTopic } from "../data/whatsapp";
import { business } from "../data/business";

export interface Props {
  title: string;
  description?: string;
  schemaType?: "WebSite" | "Service" | "Product" | "Article" | "FAQPage" | "CollectionPage";
  faqs?: { question: string; answer: string }[];
  ogImage?: string;
  noindex?: boolean;
  price?: number;
  pubDate?: Date;
  updatedDate?: Date;
  areaServed?: { type: string; name: string }[];
  serviceType?: string;
  itemList?: { name: string; url: string }[];
  // سياق رسالة واتساب (اختياري — يُستنتج من المسار إن لم يُحدَّد)
  waTopic?: WaTopic;
  waProduct?: string;
  waArea?: string;
  // أداء: صورة LCP تُحمَّل مسبقاً بنفس srcset الصورة المعروضة (لا تحميل مزدوج)
  preloadImage?: { srcset: string; sizes: string; type: string };
}

const {
  title,
  preloadImage,
  description,
  schemaType = "WebSite",
  faqs,
  ogImage = "/og/default.jpg",
  noindex = false,
  price,
  pubDate,
  updatedDate,
  areaServed,
  serviceType,
  itemList,
  waTopic,
  waProduct,
  waArea,
} = Astro.props;
// وصف احتياطي إن تُرك «وصف جوجل» فارغاً من اللوحة: الصفحة تُنشر، وseo-lint ينبّه لكتابة وصف حقيقي
// F1: اللغة من المسار (/en/ = إنجليزي)
const isEn = isEnglishPath(Astro.url.pathname);
const siteName = isEn ? nameEn : business.name;
const alternates = alternatesFor(Astro.url.pathname);
const metaDescription = description?.trim() ? description : `${title} — ${business.name}: تفصيل وتركيب ستائر بالمقاس في الكويت.`;

const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={isEn ? "en" : "ar"} dir={isEn ? "ltr" : "rtl"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d1914" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- تحميل مسبق للخطوط الظاهرة في أول شاشة (~57 ك.ب معاً): العربي 700 (العناوين) و400 (النص) و600 (<strong>)،
         واللاتيني 400 (الأرقام مثل «6 د.ك»). تصل قبل أول رسم فلا يتبدّل الخط بعد ظهور النص؛
         كان التبدّل يسبب CLS ‏0.2 في صفحات الأنواع ويؤخر LCP الرئيسية — N-32/N-33 -->
    <link rel="preload" href="/fonts/cairo-arabic-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cairo-arabic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cairo-arabic-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cairo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- A4: Google Analytics 4 مؤجَّل: gtag يُعرَّف فوراً (فتُحفظ الأحداث في dataLayer)، وسكربت gtag.js
         يُحمَّل عند أول تفاعل أو بعد 6 ثوانٍ من اكتمال الصفحة، فلا ينافس الخطوط والصور على LCP.
         لا يُحمَّل إلا على النطاق الرسمي، فلا تُحتسب زيارات المعاينة المحلية وLighthouse CI. -->
    <script is:inline define:vars={{ gaId: business.ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag("js", new Date());
      gtag("config", gaId);
      if (/(^|\.)alamcurtainskw\.com$/.test(location.hostname)) {
        var loadGa = function () {
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
          document.head.appendChild(s);
        };
        // يُحمَّل عند أول تفاعل (لمس، تمرير، نقر، لوحة مفاتيح) أو بعد 6 ثوانٍ من اكتمال الصفحة، أيهما أسبق،
        // فلا يقع تنفيذه (مهمة طويلة) في نافذة التحميل التي يقيسها Lighthouse ولا يبطئ أول تفاعل (TBT/INP).
        var done = false;
        var go = function () {
          if (done) return; done = true;
          ["pointerdown", "keydown", "scroll", "touchstart"].forEach(function (e) { removeEventListener(e, go); });
          loadGa();
        };
        ["pointerdown", "keydown", "scroll", "touchstart"].forEach(function (e) { addEventListener(e, go, { once: true, passive: true }); });
        var later = function () { setTimeout(go, 6000); };
        if (document.readyState === "complete") later(); else addEventListener("load", later, { once: true });
      }
    </script>

    {preloadImage && <link rel="preload" as="image" type={preloadImage.type} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {alternates ? (
      <>
        <link rel="alternate" hreflang="ar-KW" href={new URL(alternates.ar, Astro.site)} />
        <link rel="alternate" hreflang="en-KW" href={new URL(alternates.en, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.ar, Astro.site)} />
      </>
    ) : isEn ? (
      <link rel="alternate" hreflang="en-KW" href={canonicalURL} />
    ) : (
      <link rel="alternate" hreflang="ar-KW" href={canonicalURL} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={isEn ? "en_KW" : business.locale} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <Schema type={schemaType} title={fullTitle} description={metaDescription} faqs={faqs} image={ogImage} price={price} pubDate={pubDate} updatedDate={updatedDate} areaServed={areaServed} serviceType={serviceType} itemList={itemList}  lang={isEn ? "en" : "ar"} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    {isEn ? <EnFooter /> : <Footer />}
    {!isEn && alternates && (
      <div id="lang-suggest" hidden lang="en" dir="ltr" class="fixed inset-x-0 bottom-0 z-50 bg-charcoal text-ivory text-sm px-4 py-3 flex items-center justify-center gap-4 print:hidden">
        <a href={alternates.en} hreflang="en" data-lang-switch="en" class="font-semibold underline">View this page in English</a>
        <button type="button" data-lang-dismiss class="opacity-80 hover:opacity-100" aria-label="Dismiss">✕</button>
      </div>
    )}
    <script is:inline>
      // F1: اقتراح اللغة عند أول زيارة فقط — لا تحويل تلقائي (آمن لجوجل)، والاختيار اليدوي يُحفظ
      (function () {
        var bar = document.getElementById("lang-suggest"); if (!bar) return;
        var saved; try { saved = localStorage.getItem("lang"); } catch (e) {}
        var l = (navigator.languages && navigator.languages[0]) || navigator.language || "";
        if (!saved && /^en/i.test(l)) bar.hidden = false;
        bar.addEventListener("click", function (e) {
          var t = e.target; if (!t.closest) return;
          if (t.closest("[data-lang-dismiss]")) { bar.hidden = true; try { localStorage.setItem("lang", "ar"); } catch (e2) {} }
          if (t.closest("[data-lang-switch]")) { try { localStorage.setItem("lang", "en"); } catch (e3) {} }
        });
      })();
    </script>
    <FloatingWhatsApp topic={waTopic} product={waProduct} area={waArea} />

    <!-- تتبع نقرات واتساب: حدث whatsapp_click (يعمل مع gtag إن وُجد، وإلا يُدفع إلى dataLayer) -->
    <script>
      const UTM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
      const STORE = "stayerkw_utm";

      // حفظ مصدر الحملة في الجلسة أول ما تصل الزيارة، كي يُسجَّل مع النقرة حتى لو تنقّل الزائر
      try {
        const q = new URLSearchParams(location.search);
        const found: Record<string, string> = {};
        UTM_KEYS.forEach((k) => {
          const v = q.get(k);
          if (v) found[k] = v.slice(0, 100);
        });
        if (Object.keys(found).length) sessionStorage.setItem(STORE, JSON.stringify(found));
      } catch {}

      function savedUtm(): Record<string, string> {
        try {
          return JSON.parse(sessionStorage.getItem(STORE) || "{}");
        } catch {
          return {};
        }
      }

      document.addEventListener("click", (e) => {
        const el = (e.target as Element | null)?.closest?.("[data-wa]") as HTMLElement | null;
        if (!el) return;
        const params: Record<string, string> = {
          page_path: location.pathname,
          topic: el.dataset.waTopic || "",
          placement: el.dataset.waPlacement || "",
          product: el.dataset.waProduct || "",
          area: el.dataset.waArea || "",
          language: document.documentElement.lang || "ar",
          ...savedUtm(),
        };
        const w = window as any;
        if (typeof w.gtag === "function") {
          w.gtag("event", "whatsapp_click", { ...params, transport_type: "beacon" });
        } else {
          (w.dataLayer = w.dataLayer || []).push({ event: "whatsapp_click", ...params });
        }
      });
    </script>
  </body>
</html>

---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import type { WaTopic } from "../data/whatsapp";
import { business } from "../data/business";

export interface Props {
  title: string;
  description: string;
  schemaType?: "WebSite" | "Service" | "Product" | "Article" | "FAQPage" | "CollectionPage";
  faqs?: { question: string; answer: string }[];
  ogImage?: string;
  noindex?: boolean;
  price?: number;
  pubDate?: Date;
  updatedDate?: Date;
  areaServed?: { type: string; name: string }[];
  serviceType?: string;
  itemList?: { name: string; url: string }[];
  // سياق رسالة واتساب (اختياري — يُستنتج من المسار إن لم يُحدَّد)
  waTopic?: WaTopic;
  waProduct?: string;
  waArea?: string;
}

const {
  title,
  description,
  schemaType = "WebSite",
  faqs,
  ogImage = "/og/default.jpg",
  noindex = false,
  price,
  pubDate,
  updatedDate,
  areaServed,
  serviceType,
  itemList,
  waTopic,
  waProduct,
  waArea,
} = Astro.props;

const fullTitle = title.includes(business.name) ? title : `${title} | ${business.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d1914" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- تحميل مسبق لخط العناوين العربي (الأرجح أن يكون هو عنصر LCP) -->
    <link
      rel="preload"
      href="/fonts/cairo-arabic-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <link rel="alternate" hreflang="ar-KW" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={business.locale} />
    <meta property="og:site_name" content={business.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <Schema type={schemaType} title={fullTitle} description={description} faqs={faqs} image={ogImage} price={price} pubDate={pubDate} updatedDate={updatedDate} areaServed={areaServed} serviceType={serviceType} itemList={itemList} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp topic={waTopic} product={waProduct} area={waArea} />

    <!-- تتبع نقرات واتساب: حدث whatsapp_click (يعمل مع gtag إن وُجد، وإلا يُدفع إلى dataLayer) -->
    <script>
      const UTM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
      const STORE = "stayerkw_utm";

      // حفظ مصدر الحملة في الجلسة أول ما تصل الزيارة، كي يُسجَّل مع النقرة حتى لو تنقّل الزائر
      try {
        const q = new URLSearchParams(location.search);
        const found: Record<string, string> = {};
        UTM_KEYS.forEach((k) => {
          const v = q.get(k);
          if (v) found[k] = v.slice(0, 100);
        });
        if (Object.keys(found).length) sessionStorage.setItem(STORE, JSON.stringify(found));
      } catch {}

      function savedUtm(): Record<string, string> {
        try {
          return JSON.parse(sessionStorage.getItem(STORE) || "{}");
        } catch {
          return {};
        }
      }

      document.addEventListener("click", (e) => {
        const el = (e.target as Element | null)?.closest?.("[data-wa]") as HTMLElement | null;
        if (!el) return;
        const params: Record<string, string> = {
          page_path: location.pathname,
          topic: el.dataset.waTopic || "",
          placement: el.dataset.waPlacement || "",
          product: el.dataset.waProduct || "",
          area: el.dataset.waArea || "",
          language: document.documentElement.lang || "ar",
          ...savedUtm(),
        };
        const w = window as any;
        if (typeof w.gtag === "function") {
          w.gtag("event", "whatsapp_click", params);
        } else {
          (w.dataLayer = w.dataLayer || []).push({ event: "whatsapp_click", ...params });
        }
      });
    </script>
  </body>
</html>

---
export interface Props {
  faqs: { question: string; answer: string }[];
}
const { faqs } = Astro.props;
---
<div class="divide-y divide-sand rounded-2xl border border-sand bg-white">
  {faqs.map((faq) => (
    <details class="group p-5">
      <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-charcoal">
        {faq.question}
        <span class="text-gold-deep transition-transform group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 text-sm leading-7 text-charcoal/75">{faq.answer}</p>
    </details>
  ))}
</div>

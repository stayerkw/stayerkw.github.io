---
import { business } from "../data/business";
import { nameEn, enNav, enTypes, enAreas } from "../data/i18n";
---
<footer class="bg-charcoal text-sand mt-16" lang="en" dir="ltr">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 md:grid-cols-3 text-sm">
    <div>
      <p class="text-lg font-bold text-ivory">{nameEn}</p>
      <p class="mt-2 text-sand/80">Custom curtains and blinds, tailored in our workshop in Al-Dajeej since {business.foundedYear} and installed across all six governorates of Kuwait.</p>
    </div>
    <div>
      <p class="font-semibold text-ivory">Pages</p>
      <ul class="mt-2 space-y-1">
        {[...enNav, ...enTypes].map((i) => <li><a href={i.href} class="hover:text-gold">{i.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="font-semibold text-ivory">Contact</p>
      <p class="mt-2">Phone &amp; WhatsApp: <a href={`tel:${business.phone}`} class="hover:text-gold">{business.phone.replace("+965", "+965 ")}</a></p>
      <p class="mt-1">Open daily, 8 am to 10 pm</p>
      <p class="mt-1">We speak English and Arabic</p>
      {business.socials.map((s) => (
        <p class="mt-1"><a href={s.url} target="_blank" rel="me noopener" class="hover:text-gold inline-flex items-center gap-1.5"><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="inline-block align-[-3px]"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg><span>{s.labelEn}: {s.handle}</span></a></p>
      ))}
      <p class="mt-3 font-semibold text-ivory">Areas</p>
      <ul class="mt-1 space-y-1">{enAreas.map((a) => <li><a href={a.href} class="hover:text-gold">{a.label}</a></li>)}</ul>
      <p class="mt-3"><a href="/" hreflang="ar" lang="ar" class="hover:text-gold">الموقع بالعربية</a></p>
    </div>
  </div>
  <div class="border-t border-white/10 pt-4 pb-20 md:pb-4 text-center text-xs text-sand/60">© {new Date().getFullYear()} {nameEn}</div>
</footer>

---
// تفاصيل الطلب لصفحات المنتجات (P-PRODUCTS): كل القيم من مصدر واحد (business.ts وpricing.ts)
// فلا تتكرر أرقام الأسعار والتركيب والضمان يدوياً داخل 24 ملف منتج (N-02).
import { business } from "../data/business";
import { installRule } from "../data/pricing";

export interface Props {
  price?: number;
}
const { price } = Astro.props;
---
<section class="mt-8 rounded-2xl border border-sand bg-white p-5">
  <h2 class="text-xl font-bold text-charcoal mb-3">تفاصيل الطلب</h2>
  <ul class="space-y-2 text-charcoal/80">
    {price && <li><strong>السعر:</strong> من {price} {business.priceUnit}، والسعر شامل القماش والتفصيل.</li>}
    <li><strong>التركيب:</strong> مجاني عند {installRule.freeFrom} ستائر فأكثر، وأقل من ذلك يُضاف {installRule.fee} د.ك لكل ستارة.</li>
    {business.freeVisit && <li><strong>الزيارة والقياس:</strong> زيارة منزلية لأخذ المقاسات وعرض العينات، وهي مجانية.</li>}
    <li><strong>مدة التنفيذ:</strong> {business.leadTime}.</li>
    <li><strong>الأقمشة:</strong> {business.fabricPhrase}.</li>
    <li><strong>الضمان:</strong> {business.warranty}.</li>
  </ul>
</section>

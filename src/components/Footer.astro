---
import { business } from "../data/business";
import { mainNav } from "../data/navigation";
import { kuwaitAreas } from "../data/areas";
import { buildWhatsAppHref, inferArea, inferTopic, waTrackingAttrs } from "../data/whatsapp";

const pathname = Astro.url.pathname;
const topic = inferTopic(pathname);
const area = inferArea(pathname);
const waHref = buildWhatsAppHref({ topic, area, pageUrl: new URL(pathname, Astro.site).href });
const waTrack = waTrackingAttrs({ topic, area, placement: "footer" });
---
<footer class="bg-charcoal text-sand mt-16">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-lg font-bold text-white">{business.name}</p>
      <p class="mt-2 text-sm text-sand/80">{business.description}</p>
    </div>

    <div>
      <p class="font-semibold text-white mb-3">روابط سريعة</p>
      <ul class="space-y-2 text-sm">
        {mainNav.map((item) => (
          <li><a href={item.href} class="hover:text-gold">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white mb-3">تواصل معنا</p>
      <ul class="space-y-2 text-sm">
        <li><a href={waHref} target="_blank" rel="noopener noreferrer" {...waTrack} class="hover:text-gold">واتساب: {business.phone}</a></li>
        <li><a href={`tel:${business.phone}`} class="hover:text-gold">اتصال مباشر</a></li>
        {business.hours && <li class="text-sand/80">ساعات الدوام: {business.hours}</li>}
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white mb-3">نخدم جميع محافظات الكويت</p>
      <ul class="space-y-2 text-sm text-sand/80">
        {kuwaitAreas.map((group) => <li>{group.governorate}</li>)}
      </ul>
      <a href="/areas/" class="mt-3 inline-block text-sm text-gold hover:underline">
        كل مناطق التغطية بالتفصيل
      </a>
    </div>
  </div>

  <div class="border-t border-white/10 pt-4 pb-20 md:pb-4 text-center text-xs text-sand/60">
    © {new Date().getFullYear()} {business.name} — جميع الحقوق محفوظة
    <span class="mx-2">·</span>
    <a href="/about/" class="hover:text-gold">من نحن</a>
    <span class="mx-2">·</span>
    <a href="/warranty/" class="hover:text-gold">الضمان والاسترجاع</a>
    <span class="mx-2">·</span>
    <a href="/blog/" class="hover:text-gold">المقالات</a>
    <span class="mx-2">·</span>
    <a href="/privacy/" class="hover:text-gold">سياسة الخصوصية</a>
  </div>
</footer>

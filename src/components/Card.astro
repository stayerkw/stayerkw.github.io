---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  description: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
  priority?: boolean; // true فقط لأول بطاقة ظاهرة فوق الطية إن وُجدت
}
const { title, description, href, image, imageAlt, priority = false } = Astro.props;
---
<a
  href={href}
  class="group block overflow-hidden rounded-2xl border border-sand bg-white shadow-sm hover:shadow-lg transition-shadow"
>
  {image && (
    <Picture formats={["avif"]} fallbackFormat="webp" widths={[360, 480, 600]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 46vw, 92vw" quality={55}
      src={image}
      alt={imageAlt ?? title}
      width={600}
      height={800}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      class="aspect-[3/4] w-full object-cover"
    />
  )}
  <div class="p-5">
    <h3 class="text-lg font-bold text-charcoal group-hover:text-olive transition-colors">{title}</h3>
    <p class="mt-2 text-sm text-charcoal/75 line-clamp-2">{description}</p>
  </div>
</a>

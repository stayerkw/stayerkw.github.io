---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Card from "../../components/Card.astro";

const types = (await getCollection("curtainTypes", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout title="أنواع الستائر في الكويت" description="تعرف على أنواع الستائر في الكويت: رول وبلاك أوت وويفي وخشبية ومكتبية، مع تفصيل حسب المقاس. اطلب عرض سعر عبر واتساب.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs items={[{ label: "الرئيسية", href: "/" }, { label: "أنواع الستائر" }]} />
    <h1 class="text-3xl font-bold text-charcoal mb-8">أنواع الستائر</h1>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {types.map((type) => (
        <Card
          title={type.data.title}
          description={type.data.description}
          href={`/curtains/${type.id}/`}
        />
      ))}
    </div>
  </div>
</BaseLayout>

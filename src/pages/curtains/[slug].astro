---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import Card from "../../components/Card.astro";

export async function getStaticPaths() {
  const types = await getCollection("curtainTypes", ({ data }) => !data.draft);
  return types.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// منتجات مرتبطة بهذا النوع (عبر حقل curtainType في المنتج) — روابط داخلية تساعد جوجل
// على فهم العلاقة بين الصفحات وتزيد فرصة ظهور الصفحتين معاً في نتائج البحث.
const relatedProducts = (await getCollection("products", ({ data }) => !data.draft)).filter(
  (p) => p.data.curtainType === entry.id
);
---
<BaseLayout title={entry.data.title} description={entry.data.description} schemaType="Product">
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs
      items={[
        { label: "الرئيسية", href: "/" },
        { label: "أنواع الستائر", href: "/curtains/" },
        { label: entry.data.title },
      ]}
    />
    <h1 class="text-3xl font-bold text-charcoal mb-6">{entry.data.title}</h1>
    <div class="prose prose-neutral max-w-none prose-headings:text-charcoal">
      <Content />
    </div>
    <div class="mt-10">
      <WhatsAppButton label={`اطلب ${entry.data.title} الآن`} />
    </div>

    {relatedProducts.length > 0 && (
      <div class="mt-16">
        <h2 class="text-xl font-bold text-charcoal mb-6">منتجات من هذا النوع</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {relatedProducts.map((product) => (
            <Card
              title={product.data.title}
              description={product.data.description}
              href={`/products/${product.id}/`}
              image={product.data.image}
              imageAlt={product.data.imageAlt}
            />
          ))}
        </div>
      </div>
    )}
  </article>
</BaseLayout>


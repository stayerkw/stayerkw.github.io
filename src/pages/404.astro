---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { mainNav } from "../data/navigation";
---
<BaseLayout
  title="الصفحة غير موجودة"
  description="الصفحة التي تبحث عنها غير موجودة. تصفح أنواع الستائر والخدمات، أو تواصل معنا مباشرة عبر واتساب."
  noindex={true}
>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-gold mb-4">404</p>
    <h1 class="text-2xl font-bold text-charcoal mb-4">هذه الصفحة غير موجودة</h1>
    <p class="text-charcoal/70 mb-8">
      ربما تغيّر الرابط أو كُتب بشكل خاطئ. جرّب أحد الروابط التالية:
    </p>
    <ul class="flex flex-wrap justify-center gap-3 mb-10 text-sm">
      {mainNav.map((item) => (
        <li>
          <a href={item.href} class="rounded-full border border-sand px-4 py-2 text-charcoal hover:bg-sand transition-colors">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <WhatsAppButton label="تواصل معنا عبر واتساب" />
  </div>
</BaseLayout>

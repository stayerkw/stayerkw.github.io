---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { business } from "../data/business";

const products = (await getCollection("products", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const types = (await getCollection("curtainTypes", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const services = (await getCollection("services", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={business.name} description={business.description}>
  <section class="bg-sand">
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-20 grid gap-10 md:grid-cols-2 items-center">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-charcoal leading-tight">
          تفصيل وتركيب ستائر حسب المقاس في الكويت
        </h1>
        <p class="mt-4 text-charcoal/70 text-lg">
          رول، بلاك أوت، شيفون، وستائر كهربائية — قياس دقيق، تفصيل احترافي، وتركيب متقن.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <WhatsAppButton />
          <a
            href="/curtains/"
            class="inline-flex items-center gap-2 rounded-full border border-charcoal px-6 py-3 font-semibold text-charcoal hover:bg-charcoal hover:text-white transition-colors"
          >
            تصفح الأنواع
          </a>
        </div>
      </div>
    </div>
  </section>

  {products.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-14 md:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-charcoal mb-1">من منتجاتنا</h2>
          <p class="text-charcoal/60 text-sm">نماذج حقيقية من تنفيذاتنا — ألوان وخامات متعددة متوفرة</p>
        </div>
        <a href="/products/" class="shrink-0 text-sm font-semibold text-olive hover:underline">
          عرض كل المنتجات ←
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <a
            href={`/products/${product.id}/`}
            class="group block overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-md transition-shadow"
          >
            {product.data.image && (
              <Image
                src={product.data.image}
                alt={product.data.imageAlt ?? product.data.title}
                width={600}
                height={450}
                loading="lazy"
                fetchpriority="auto"
                class="h-44 w-full object-cover"
              />
            )}
            <div class="p-4">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-bold text-charcoal group-hover:text-olive transition-colors">
                  {product.data.title}
                </h3>
                {product.data.price && (
                  <span class="shrink-0 rounded-full bg-sand px-2.5 py-1 text-xs font-semibold text-charcoal">
                    {product.data.price} د.ك/م
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-sm text-charcoal/60 line-clamp-2">{product.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bg-white border-y border-sand">
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-16 grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-charcoal mb-1">أنواع الستائر</h2>
        <p class="text-charcoal/60 text-sm mb-4">اختر النوع المناسب لمساحتك</p>
        <ul class="divide-y divide-sand">
          {types.map((type) => (
            <li>
              <a href={`/curtains/${type.id}/`} class="group flex items-center justify-between gap-4 py-3.5">
                <span>
                  <span class="block font-semibold text-charcoal group-hover:text-olive transition-colors">
                    {type.data.title}
                  </span>
                  <span class="block text-sm text-charcoal/55 mt-0.5 line-clamp-1">{type.data.description}</span>
                </span>
                <span class="shrink-0 text-charcoal/30 group-hover:text-olive group-hover:-translate-x-1 transition-all" aria-hidden="true">←</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/curtains/" class="mt-4 inline-block text-sm font-semibold text-olive hover:underline">
          عرض كل الأنواع ←
        </a>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-charcoal mb-1">خدماتنا</h2>
        <p class="text-charcoal/60 text-sm mb-4">من القياس إلى التركيب النهائي</p>
        <ul class="divide-y divide-sand">
          {services.map((service) => (
            <li>
              <a href={`/services/${service.id}/`} class="group flex items-center justify-between gap-4 py-3.5">
                <span>
                  <span class="block font-semibold text-charcoal group-hover:text-olive transition-colors">
                    {service.data.title}
                  </span>
                  <span class="block text-sm text-charcoal/55 mt-0.5 line-clamp-1">{service.data.description}</span>
                </span>
                <span class="shrink-0 text-charcoal/30 group-hover:text-olive group-hover:-translate-x-1 transition-all" aria-hidden="true">←</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/services/" class="mt-4 inline-block text-sm font-semibold text-olive hover:underline">
          عرض كل الخدمات ←
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 text-center">
    <h2 class="text-2xl font-bold text-charcoal mb-3">جاهز لتجديد نوافذك؟</h2>
    <p class="text-charcoal/60 mb-8 max-w-xl mx-auto">
      تواصل معنا الآن واحصل على عرض سعر مبدئي خلال دقائق. نخدم
      <a href="/مناطق-الخدمة/" class="text-olive underline hover:text-charcoal">جميع محافظات الكويت الست</a>،
      من العاصمة إلى الجهراء.
    </p>
    <WhatsAppButton />
  </section>
</BaseLayout>

---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { roomLabels } from "../../data/projects";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
// 5.1: لا صفحة بلا دليل. ما دام لا يوجد مشروع حقيقي منشور تبقى الصفحة noindex (وخارج sitemap).
const hasProjects = projects.length > 0;
---
<BaseLayout
  title="أعمالنا: مشاريع ستائر منفذة"
  description="مشاريع ستائر منفذة في الكويت بصور قبل وبعد: النوع والغرفة والمنطقة والحل المنفذ، تُنشر بموافقة أصحابها. أرسل صورة نافذتك لعرض سعر."
  schemaType="CollectionPage"
  itemList={projects.map((p) => ({ name: p.data.title, url: `/projects/${p.id}/` }))}
  noindex={!hasProjects}
  waTopic="general"
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs items={[{ label: "الرئيسية", href: "/" }, { label: "أعمالنا" }]} />
    <h1 class="text-3xl font-bold text-charcoal mb-4">أعمالنا</h1>
    {hasProjects ? (
      <>
        <p class="mb-8 max-w-2xl text-charcoal/75">
          مشاريع نفّذناها فعلاً، بصورها والمشكلة التي أراد العميل حلها والحل المنفذ. تُنشر كل مشروع بموافقة صاحبه.
        </p>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => {
            const cover = p.data.images.find((i) => i.label === "after") ?? p.data.images[0];
            return (
              <a href={`/projects/${p.id}/`} class="group block overflow-hidden rounded-2xl border border-sand bg-white shadow-sm hover:shadow-lg transition-shadow">
                <Image src={cover.src} alt={cover.alt} width={600} height={800} loading="lazy" class="aspect-[3/4] w-full object-cover" />
                <div class="p-5">
                  <h2 class="text-lg font-bold text-charcoal group-hover:text-olive transition-colors">{p.data.title}</h2>
                  <p class="mt-1 text-sm text-charcoal/60">
                    {p.data.governorate}{p.data.area ? ` — ${p.data.area}` : ""} · {roomLabels[p.data.room]}
                  </p>
                  <p class="mt-2 text-sm text-charcoal/75 line-clamp-2">{p.data.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </>
    ) : (
      <div class="max-w-2xl">
        <p class="text-charcoal/75">
          نضيف هنا مشاريعنا المنفذة بصور قبل وبعد، وكل مشروع يُنشر بموافقة صاحبه. لا نعرض أعمالاً لم ننفذها.
        </p>
        <p class="mt-4 text-charcoal/75">
          في الأثناء، أرسل لنا صورة نافذتك أو مقاسها عبر واتساب لنعرض عليك الأنواع والسعر.
        </p>
        <div class="mt-6">
          <WhatsAppButton topic="general" placement="content" />
        </div>
      </div>
    )}
  </div>
</BaseLayout>

---
// آراء العملاء: المراجعات المنشورة + نموذج بسيط (نجوم، اسم، ملاحظة) تُنشر تلقائياً بلا موافقة مسبقة.
// المالك يخفي أو يحذف أي مراجعة من لوحة التحكم (قسم «مراجعات العملاء»). لا تُضاف مراجعة بلا عميل حقيقي.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { business } from "../../data/business";
import { approvedReviews, ratingSummary, stars } from "../../lib/reviews";
import ReviewList from "../../components/ReviewList.astro";
import ReviewForm from "../../components/ReviewForm.astro";

const reviews = await approvedReviews();
const summary = ratingSummary(reviews);
const products = (await getCollection("products", ({ data }) => !data.draft && !data.noindex)).sort((a, b) => a.data.title.localeCompare(b.data.title, "ar"));
const titleOf = new Map(products.map((p) => [p.id, p.data.title]));
---
<BaseLayout
  title="آراء العملاء ومراجعاتهم"
  noindex={reviews.length === 0}
  description={`مراجعات عملاء ${business.name} الحقيقية عن تفصيل وتركيب الستائر في الكويت. اكتب مراجعتك عن ستارتك وأرسلها مباشرة من الموقع.`}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <Breadcrumbs items={[{ label: "الرئيسية", href: "/" }, { label: "آراء العملاء" }]} />
    <h1 class="text-3xl font-bold text-charcoal mb-3">آراء عملاء {business.name}</h1>
    <p class="text-charcoal/70">كل المراجعات هنا من عملاء حقيقيين، وتُنشر كما كتبوها.</p>
    {summary && <p class="mt-3 text-lg"><span class="text-gold-deep" aria-hidden="true">{stars(summary.average)}</span> {summary.average} من 5 — {summary.count} {summary.count === 1 ? "مراجعة" : "مراجعات"}</p>}

    <ReviewList reviews={reviews} titles={titleOf} />

    <div id="form" class="mt-10 rounded-2xl border border-sand bg-white p-5">
      <h2 class="text-xl font-bold text-charcoal">اكتب ملاحظتك</h2>
      <ReviewForm />
    </div>
  </div>
</BaseLayout>

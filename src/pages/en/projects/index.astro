---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout title="Our Curtain Projects in Kuwait" description="Real curtain and blind projects we tailored and installed in Kuwait: diwaniyas, majlis, living rooms, bedrooms, kitchens, bathrooms and a paediatric clinic." schemaType="CollectionPage">
  <section class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal">Our Work in Kuwait</h1>
    <p class="mt-4 text-charcoal/85 leading-8">A selection of real projects, each tailored to the window and installed by our team. More photos are on our <a href="/projects/" hreflang="ar" class="text-olive underline">Arabic projects page</a>.</p>
    <ul class="mt-8 space-y-5">
      <li><a href="/en/projects/capital-zebra-grey-clinic/" class="text-lg font-semibold text-charcoal hover:text-olive">Zebra Blinds for a Kids’ Clinic</a><p class="text-sm text-charcoal/70">Kuwait City (Capital Governorate) · Zebra blinds</p></li>
      <li><a href="/en/projects/capital-wave-beige-sheer-living/" class="text-lg font-semibold text-charcoal hover:text-olive">Wave Curtains for a Full Wall</a><p class="text-sm text-charcoal/70">Kuwait City (Capital Governorate) · Wave curtains with sheer</p></li>
      <li><a href="/en/projects/hawalli-wave-grey-sheer-diwaniya/" class="text-lg font-semibold text-charcoal hover:text-olive">Wave Curtains for a Diwaniya</a><p class="text-sm text-charcoal/70">Hawalli Governorate · Wave curtains with sheer</p></li>
      <li><a href="/en/projects/hawalli-majlis-curved-sheer-tassels/" class="text-lg font-semibold text-charcoal hover:text-olive">Curved Curtains for a Round Majlis</a><p class="text-sm text-charcoal/70">Hawalli Governorate · Wave curtains with sheer</p></li>
      <li><a href="/en/projects/hawalli-wave-grey-staircase/" class="text-lg font-semibold text-charcoal hover:text-olive">Wave Curtains for a Staircase Window</a><p class="text-sm text-charcoal/70">Hawalli Governorate · Wave curtains</p></li>
      <li><a href="/en/projects/capital-wooden-brown-kitchen/" class="text-lg font-semibold text-charcoal hover:text-olive">Wooden Blinds for a Kitchen</a><p class="text-sm text-charcoal/70">Kuwait City (Capital Governorate) · Wooden blinds</p></li>
      <li><a href="/en/projects/capital-roll-white-bathroom/" class="text-lg font-semibold text-charcoal hover:text-olive">Roller Blind for a Bathroom</a><p class="text-sm text-charcoal/70">Kuwait City (Capital Governorate) · Roller blinds</p></li>
      <li><a href="/en/projects/blackout-wave-beige-sheer-bedroom/" class="text-lg font-semibold text-charcoal hover:text-olive">Blackout Curtains for a Bedroom</a><p class="text-sm text-charcoal/70">Kuwait · Blackout curtains</p></li>
      <li><a href="/en/projects/capital-zebra-black-bedroom/" class="text-lg font-semibold text-charcoal hover:text-olive">Black Zebra Blind for a Bedroom</a><p class="text-sm text-charcoal/70">Kuwait City (Capital Governorate) · Zebra blinds</p></li>
      <li><a href="/en/projects/hawalli-roll-white-glass-corridor/" class="text-lg font-semibold text-charcoal hover:text-olive">Roller Blinds for a Glass Corridor</a><p class="text-sm text-charcoal/70">Hawalli Governorate · Roller blinds</p></li>
    </ul>
  </section>
</BaseLayout>

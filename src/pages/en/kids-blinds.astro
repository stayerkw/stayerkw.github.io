---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Picture } from "astro:assets";
import img from "../../content/curtain-types/images/kids-astronaut-room.jpg";
const faqs = [{"question": "How much are kids’ curtains?", "answer": "Kids’ curtains start at 6 KWD per square metre. A roller blind printed with a custom design of your choice is 13 KWD per m²."}, {"question": "Can you print my own design?", "answer": "Yes. Send us the design or idea and we print it on the roller blind to your window size."}, {"question": "Are printed blinds dark enough for naps?", "answer": "A printed roller blind softens the light. For a darker room for naps, ask about blackout options."}];
---
<BaseLayout title="Kids’ Blinds Kuwait — Custom Printed" description="Kids’ curtains and blinds in Kuwait: printed roller blinds with playful designs or your own custom print, from 6 KWD per m², custom printing 13 KWD per m²." schemaType="Service" faqs={faqs}>
  <article class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal leading-tight">Kids’ Blinds in Kuwait</h1>
    <p class="mt-4 text-charcoal/85 leading-8">Kids’ rooms are where curtains can be fun. We make printed roller blinds with space, animals, watercolour scenes and soft pastels, or we print your own design to the exact size of the window.</p>
    <Picture src={img} alt="Kids’ bedroom with two beds and an astronaut-themed printed blind" formats={["avif"]} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(min-width: 800px) 736px, 92vw" quality={60} loading="eager" class="my-6 w-full rounded-2xl" />
    <h2 class="mt-10 text-2xl font-bold text-charcoal">Options and prices</h2>
    <ul class="mt-4 list-disc ps-6 space-y-2 text-charcoal/85 leading-7">
      <li><strong>Kids’ curtains and printed designs:</strong> from 6 KWD per m².</li>
      <li><strong>Custom-printed roller blind</strong> with your own design: 13 KWD per m².</li>
      <li><strong>Darker rooms</strong> for naps: combine with <a class="text-olive underline" href="/en/blackout-curtains/">blackout</a>.</li>
    </ul>
    <p class="mt-4 text-charcoal/85 leading-8">Installation is free for orders of 5 curtains or more; below that it is 5 KWD per curtain. The home visit to measure and show samples is free, except in Abdali and Subiya.</p>

    <h2 class="mt-10 text-2xl font-bold text-charcoal">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (<div><p class="font-semibold text-charcoal">{f.question}</p><p class="mt-1 text-charcoal/80 leading-7">{f.answer}</p></div>))}
    </div>
    <div class="mt-10"><WhatsAppButton label="Get a quote on WhatsApp" /></div>
  </article>
</BaseLayout>

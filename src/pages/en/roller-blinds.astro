---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Picture } from "astro:assets";
import img from "../../content/projects/images/capital-roll-white-bathroom-1.jpg";
const faqs = [{"question": "How much are roller blinds in Kuwait?", "answer": "Standard and blackout roller blinds cost 6 KWD per square metre, zebra blinds 9 KWD, and custom-printed roller blinds 13 KWD. Installation is free for orders of 5 curtains or more; below that it is 5 KWD per curtain."}, {"question": "What is a zebra blind?", "answer": "A roller blind with two layers of alternating sheer and solid stripes. Moving the chain lines the stripes up to let light in or offsets them for privacy, without raising the blind."}, {"question": "Are roller blinds good for bathrooms and kitchens?", "answer": "Yes. They have no folds to collect moisture or dust and wipe clean with a damp cloth."}];
---
<BaseLayout title="Roller Blinds Kuwait — Custom Sizes" description="Roller blinds in Kuwait made to measure: light-filtering, blackout, zebra day and night and office blinds, from 6 KWD per square metre with a free visit." schemaType="Service" faqs={faqs}>
  <article class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal leading-tight">Roller Blinds in Kuwait</h1>
    <p class="mt-4 text-charcoal/85 leading-8">Roller blinds are flat fabric that rolls up onto a tube at the top of the window. They take no space, look tidy, and are the most popular window blinds for kitchens, bathrooms, bedrooms and offices in Kuwait. We make them to the exact size of your window.</p>
    <Picture src={img} alt="White light-filtering roller blind on a bathroom window with a freestanding bathtub" formats={["avif"]} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(min-width: 800px) 736px, 92vw" quality={60} loading="eager" class="my-6 w-full rounded-2xl" />
    <h2 class="mt-10 text-2xl font-bold text-charcoal">Types of roller blinds</h2>
    <ul class="mt-4 list-disc ps-6 space-y-2 text-charcoal/85 leading-7">
      <li><strong>Light-filtering:</strong> soft daylight with privacy. 6 KWD per m².</li>
      <li><strong>Blackout roller:</strong> blocks the light for bedrooms. 6 KWD per m². More on <a class="text-olive underline" href="/en/blackout-curtains/">blackout curtains</a>.</li>
      <li><strong>Zebra (day and night):</strong> alternating sheer and solid stripes to control light without raising the blind. 9 KWD per m².</li>
      <li><strong>Office blinds:</strong> wide glass fronts split into several blinds, each operated on its own. 6 KWD per m².</li>
      <li><strong>Custom-printed:</strong> your own design printed on the blind, popular for kids’ rooms. 13 KWD per m².</li>
    </ul>
    <h2 class="mt-10 text-2xl font-bold text-charcoal">Example</h2>
    <p class="mt-4 text-charcoal/85 leading-8">A 2 × 2.5 m window (5 m²) with a blackout roller blind costs 5 × 6 = 30 KWD, plus 5 KWD installation if your order is under 5 blinds. The home visit to take measurements and show fabric samples is free (except in Abdali and Subiya, where the visit is paid).</p>

    <h2 class="mt-10 text-2xl font-bold text-charcoal">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (<div><p class="font-semibold text-charcoal">{f.question}</p><p class="mt-1 text-charcoal/80 leading-7">{f.answer}</p></div>))}
    </div>
    <div class="mt-10"><WhatsAppButton label="Get a quote on WhatsApp" /></div>
  </article>
</BaseLayout>

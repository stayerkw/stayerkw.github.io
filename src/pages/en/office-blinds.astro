---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Picture } from "astro:assets";
import img from "../../content/products/images/roller-office-grey.jpg";
const faqs = [{"question": "Which blinds are best for offices?", "answer": "Roller blinds are the most common: tidy, easy to wipe and good at cutting screen glare. Zebra blinds suit clinics and meeting rooms, and wooden blinds suit executive offices."}, {"question": "Can you split a wide glass front?", "answer": "Yes. We divide wide facades into several blinds side by side, so each person adjusts the part in front of them."}, {"question": "Do you handle large office orders?", "answer": "Yes. Installation is free for 5 blinds or more, the measurement visit is free, and most orders are done in 2 to 3 days."}];
---
<BaseLayout title="Office Blinds Kuwait" description="Office blinds in Kuwait for companies, clinics and meeting rooms: roller blinds from 6 KWD per m², zebra blinds 9 KWD and wooden blinds 13 KWD per m²." schemaType="Service" faqs={faqs}>
  <article class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal leading-tight">Office Blinds in Kuwait</h1>
    <p class="mt-4 text-charcoal/85 leading-8">For offices we mostly fit roller blinds: they control glare on screens, look tidy against glass facades and suspended ceilings, and wipe clean. Wide windows are split into several blinds so each section is raised on its own.</p>
    <Picture src={img} alt="Three grey roller blinds side by side on an office window with a suspended ceiling" formats={["avif"]} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(min-width: 800px) 736px, 92vw" quality={60} loading="eager" class="my-6 w-full rounded-2xl" />
    <h2 class="mt-10 text-2xl font-bold text-charcoal">By space</h2>
    <ul class="mt-4 list-disc ps-6 space-y-2 text-charcoal/85 leading-7">
      <li><strong>Offices and open-plan areas:</strong> <a class="text-olive underline" href="/en/roller-blinds/">roller blinds</a>, 6 KWD per m².</li>
      <li><strong>Meeting rooms:</strong> blackout roller blinds for presentations, 6 KWD per m².</li>
      <li><strong>Clinics and reception:</strong> <a class="text-olive underline" href="/en/zebra-blinds/">zebra blinds</a> for light and privacy, 9 KWD per m².</li>
      <li><strong>Executive offices:</strong> <a class="text-olive underline" href="/en/wooden-blinds/">wooden blinds</a>, 13 KWD per m².</li>
    </ul>
    <p class="mt-4 text-charcoal/85 leading-8">Installation is free for orders of 5 curtains or more; below that it is 5 KWD per curtain. The home visit to measure and show samples is free, except in Abdali and Subiya.</p>

    <h2 class="mt-10 text-2xl font-bold text-charcoal">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (<div><p class="font-semibold text-charcoal">{f.question}</p><p class="mt-1 text-charcoal/80 leading-7">{f.answer}</p></div>))}
    </div>
    <div class="mt-10"><WhatsAppButton label="Get a quote on WhatsApp" /></div>
  </article>
</BaseLayout>

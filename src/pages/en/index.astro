---
// الصفحة الرئيسية الإنجليزية (31 أكتوبر 2026): نفس بنية الصفحة العربية وثرائها (أنواع بأقواس، أعمال، خطوات، مناطق، أسئلة)
// مع الحفاظ على الرابط والعنوان والوصف وH1 وكل الروابط الداخلية السابقة كما هي — لا حاجة لإعادة فهرسة.
// LCP: أول بطاقة نوع تُحمَّل مسبقاً WebP بنفس srcset/sizes كما في الرئيسية العربية؛ بقية الصور lazy.
import { Picture, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import FAQ from "../../components/FAQ.astro";
import { priceList, installRule } from "../../data/pricing";
import { business } from "../../data/business";
import { projectsEn } from "../../data/projects-en";

import imgRoll from "../../content/products/images/roll-ready-white-living.jpg";
import imgWave from "../../content/products/images/wave-grey-brown-cream-sheer.jpg";
import imgBlackout from "../../content/products/images/roller-dark-living.jpg";
import imgSheer from "../../content/curtain-types/images/sheer-white-kitchen.jpg";
import imgKids from "../../content/curtain-types/images/kids-astronaut-room.jpg";
import imgWooden from "../../content/products/images/wooden-white-bedroom.jpg";
import imgZebra from "../../content/projects/images/capital-zebra-black-bedroom-1.jpg";
import imgOffice from "../../content/projects/images/hawalli-roll-white-glass-corridor-1.jpg";

// الأسعار من مصدر الأسعار الواحد (لوحة التحكم). الويفي وحده للمتر الطولي (قرار المالك 30 أكتوبر 2026).
const price = (id: string) => priceList.find((r) => r.id === id)?.price ?? "—";
const types = [
  { id: "roll", name: "Roller blinds", href: "/en/roller-blinds/", img: imgRoll, alt: "Grey roller blind in a living room in Kuwait" },
  { id: "zebra", name: "Zebra (day & night) blinds", href: "/en/zebra-blinds/", img: imgZebra, alt: "Black zebra blind with open stripes letting daylight into a bedroom" },
  { id: "wave", name: "Wave curtains", href: "/en/wave-curtains/", img: imgWave, alt: "Grey wave curtains with a cream sheer and side tieback", unit: "linear metre" },
  { id: "blackout", name: "Blackout curtains", href: "/en/blackout-curtains/", img: imgBlackout, alt: "Dark blackout roller blind in front of a tall window" },
  { id: "sheer", name: "Sheer curtains", href: "/en/sheer-curtains/", img: imgSheer, alt: "White sheer curtains with soft folds in a room" },
  { id: "kids", name: "Kids’ blinds", href: "/en/kids-blinds/", img: imgKids, alt: "Kids’ room with two beds and a printed astronaut blind" },
  { id: "wooden", name: "Wooden blinds", href: "/en/wooden-blinds/", img: imgWooden, alt: "White wooden blinds in a bedroom" },
  { id: "office", name: "Office blinds", href: "/en/office-blinds/", img: imgOffice, alt: "White roller blinds along a glass corridor" },
].map((t) => ({ ...t, price: price(t.id), unit: t.unit ?? "m²" }));

// أعمال حقيقية لها صفحات إنجليزية (/en/projects/…) — الصورة الأولى من مجموعة المشاريع نفسها
const projectImages = import.meta.glob<{ default: ImageMetadata }>("../../content/projects/images/*-1.jpg", { eager: true });
const featured = ["capital-wave-beige-sheer-living", "hawalli-wave-grey-sheer-diwaniya", "capital-zebra-grey-clinic", "hawalli-majlis-curved-sheer-tassels", "capital-wooden-brown-kitchen", "hawalli-roll-white-glass-corridor"]
  .map((slug) => {
    const p = projectsEn.find((x) => x.slug === slug);
    const img = projectImages[`../../content/projects/images/${slug}-1.jpg`]?.default;
    return p && img ? { ...p, img } : null;
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);

const TILE_W = [320, 480, 640];
const TILE_SIZES = "(min-width: 1024px) 280px, 72vw";
const lcpWebp = await getImage({ src: imgRoll, format: "webp", width: 640, height: 853, widths: TILE_W, quality: 70 });

const steps = [
  { t: "Measure", d: "Send a photo of your window and its rough size on WhatsApp for an initial quote, then we visit to take exact measurements and show fabric samples." },
  { t: "Tailor", d: "You choose the type, fabric and colour, and we sew each curtain to your window in our workshop in Al-Dajeej, using Turkish fabrics in every type of yarn." },
  { t: "Install", d: "Our team fits the track or blind and checks how it opens and closes with you before leaving." },
];

const areas = [
  { name: "Salmiya", href: "/en/curtains-salmiya/" },
  { name: "Mangaf, Mahboula & Fahaheel", href: "/en/curtains-mangaf-mahboula/" },
  { name: "Kuwait City", href: "/en/curtains-kuwait-city/" },
  { name: "Sharq (offices)", href: "/en/curtains-sharq/" },
  { name: "Farwaniya & Khaitan", href: "/en/curtains-farwaniya-khaitan/" },
];

// الأسئلة الثلاثة الأولى كما كانت (FAQPage schema)، وأُضيف سؤالان بمعلومات مؤكدة
const faqs = [
  { question: "How much do curtains cost in Kuwait?", answer: `Our prices include fabric, track and tailoring: from ${price("sheer")} KWD per m² for sheers, ${price("roll")} KWD per m² for roller and blackout, ${price("zebra")} KWD per m² for zebra and ${price("wooden")} KWD per m² for wooden blinds. Wave curtains are priced per linear metre, from ${price("wave")} KWD. Installation is free for orders of ${installRule.freeFrom} curtains or more; below that it is ${installRule.fee} KWD per curtain.` },
  { question: "Do you cover my area?", answer: "Yes, we tailor and install curtains in all six governorates of Kuwait: Capital, Hawalli, Farwaniya, Ahmadi, Mubarak Al-Kabeer and Jahra." },
  { question: "How long does it take?", answer: "Usually 2 to 3 days depending on the quantity, after the measurement visit and fabric selection." },
  { question: "Can I arrange everything in English?", answer: "Yes. Our team includes an English-speaking staff member, so the quote, measurement visit and installation can all be arranged in English on WhatsApp or by phone." },
  { question: "Is the measurement visit free?", answer: "Yes, the home visit to take measurements and show fabric samples is free in every area of Kuwait except Abdali and Subiya, where the visit is paid." },
];
---
<BaseLayout
  preloadImage={{ srcset: lcpWebp.srcSet.attribute, sizes: TILE_SIZES, type: "image/webp" }}
  title="Curtains Kuwait — Made to Measure"
  description="Custom curtains and blinds in Kuwait, made to measure since 2012: wave curtains, sheers, roller, blackout, zebra and wooden blinds, priced per square metre."
  schemaType="WebSite"
  faqs={faqs}
>
  <section class="mx-auto max-w-6xl px-4 pt-10 md:pt-16">
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <h1 class="text-4xl md:text-6xl font-bold leading-[1.15] tracking-tight text-charcoal">
          Custom Curtains in Kuwait, Made to Measure
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-charcoal/75">
          Wave curtains, sheers and blinds for homes, majlis and offices, tailored in our own workshop since {business.foundedYear}. Send a photo of your window on WhatsApp and we reply with an initial quote, in English.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <WhatsAppButton label="Send your window size on WhatsApp" placement="hero" class="px-7 py-3.5 text-lg" />
          <a href="/en/curtain-prices/" class="inline-flex items-center rounded-full border border-charcoal/25 px-6 py-3.5 font-semibold text-charcoal hover:bg-sand transition-colors">
            Curtain prices
          </a>
        </div>
      </div>
      <dl class="grid grid-cols-3 gap-4 border-t border-charcoal/15 pt-5 text-sm lg:grid-cols-1 lg:gap-0 lg:divide-y lg:divide-charcoal/15 lg:border-t-0 lg:border-s lg:ps-8 lg:pt-0">
        <div class="lg:py-3">
          <dt class="text-charcoal/60">Prices</dt>
          <dd class="mt-1 font-bold text-charcoal">From {price("sheer")} KWD per m²</dd>
        </div>
        <div class="lg:py-3">
          <dt class="text-charcoal/60">Home visit</dt>
          <dd class="mt-1 font-bold text-charcoal">Free measuring<span class="block text-xs font-normal text-charcoal/60">except Abdali and Subiya</span></dd>
        </div>
        <div class="lg:py-3">
          <dt class="text-charcoal/60">Lead time</dt>
          <dd class="mt-1 font-bold text-charcoal">2 to 3 days</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mt-10 md:mt-14" aria-labelledby="types-title">
    <div class="mx-auto max-w-6xl px-4 mb-5 flex items-end justify-between gap-4">
      <h2 id="types-title" class="text-2xl md:text-3xl font-bold text-charcoal">What we make</h2>
      <a href="/en/custom-curtains/" class="shrink-0 text-sm font-semibold text-gold-deep hover:underline">Custom curtains</a>
    </div>
    <ul class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 lg:mx-auto lg:grid lg:max-w-6xl lg:grid-cols-4 lg:gap-x-6 lg:gap-y-10 lg:overflow-visible">
      {types.map((t, i) => (
        <li class="w-[72%] shrink-0 snap-start sm:w-[44%] lg:w-auto">
          <a href={t.href} class="group block">
            <div class="aspect-[3/4] overflow-hidden rounded-t-full bg-sand">
              {i === 0 ? (
                <picture>
                  <img src={lcpWebp.src} srcset={lcpWebp.srcSet.attribute} sizes={TILE_SIZES} alt={t.alt} width="640" height="853" loading="eager" fetchpriority="high" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                </picture>
              ) : (
                <Picture src={t.img} alt={t.alt} formats={["avif"]} fallbackFormat="webp" width={640} height={853} widths={TILE_W} sizes={TILE_SIZES} quality={65} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
              )}
            </div>
            <h3 class="mt-4 text-xl font-bold text-charcoal">{t.name}</h3>
            <p class="text-sm text-charcoal/65">From {t.price} KWD per {t.unit}</p>
          </a>
          <WhatsAppButton label="Order this on WhatsApp" product={t.name} placement="type-tile" class="mt-3 px-5! py-2! text-sm" />
        </li>
      ))}
    </ul>
    <p class="mx-auto max-w-6xl px-4 mt-4 text-charcoal/75 leading-7">
      Wave curtains also come with a sheer layer on a double track, from {price("wave-sheer")} KWD per linear metre, for living rooms, majlis and diwaniya.
    </p>
  </section>

  {featured.length > 0 && (
    <section class="mt-14 md:mt-20 bg-sand/60 border-y border-sand" aria-labelledby="works-title">
      <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
        <div class="mb-6 flex items-end justify-between gap-4">
          <h2 id="works-title" class="text-2xl md:text-3xl font-bold text-charcoal">Recent work in Kuwait</h2>
          <a href="/en/projects/" class="shrink-0 text-sm font-semibold text-gold-deep hover:underline">All projects</a>
        </div>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3">
          {featured.map((p) => (
            <li>
              <a href={`/en/projects/${p.slug}/`} class="group block">
                <div class="aspect-[3/4] overflow-hidden bg-sand">
                  <Picture src={p.img} alt={p.description} formats={["avif"]} fallbackFormat="webp" width={600} height={800} widths={[240, 360, 480, 600]} sizes="(min-width: 768px) 360px, 46vw" quality={65} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                </div>
                <h3 class="mt-3 font-bold text-charcoal">{p.title}</h3>
                <p class="text-sm text-charcoal/65">{p.room}, {p.location}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 py-14 md:py-20" aria-labelledby="steps-title">
    <h2 id="steps-title" class="text-2xl md:text-3xl font-bold text-charcoal mb-8">How it works</h2>
    <ol class="grid gap-8 md:grid-cols-3 md:gap-10">
      {steps.map((s, i) => (
        <li class="border-t-2 border-charcoal pt-4">
          <p class="text-sm font-bold text-gold-deep">Step {i + 1}</p>
          <h3 class="mt-1 text-xl font-bold text-charcoal">{s.t}</h3>
          <p class="mt-2 leading-8 text-charcoal/75">{s.d}</p>
        </li>
      ))}
    </ol>
    <p class="mt-8 max-w-3xl text-charcoal/75 leading-8">
      See <a class="text-gold-deep underline" href="/en/curtain-installation/">curtain installation</a> for how we fit tracks and blinds. Installation is free for orders of {installRule.freeFrom} curtains or more; below that it is {installRule.fee} KWD per curtain. Every curtain has a 3-day warranty covering adjustments for manufacturing defects.
    </p>
  </section>

  <section class="bg-white border-y border-sand">
    <div class="mx-auto max-w-3xl px-4 py-14 md:py-16">
      <h2 class="text-2xl font-bold text-charcoal mb-4">Curtains in Kuwait, tailored to measure and installed in every governorate</h2>
      <div class="space-y-4 leading-8 text-charcoal/80">
        <p>
          Alam Curtains Kuwait has been tailoring curtains since {business.foundedYear}. We are a curtain shop with our own workshop, and our team includes an English-speaking staff member, so you can arrange everything in English. Curtains, drapes and window blinds, made to measure: we visit your home to measure every window and show you fabric samples, sew each curtain in our workshop in Al-Dajeej, and install it in 2 to 3 days. Prices are clear, per square metre (wave curtains per linear metre), so you know the cost before you order.
        </p>
        <p>
          Choose <a class="text-gold-deep underline" href="/en/wave-curtains/">wave curtains</a> and sheers, <a class="text-gold-deep underline" href="/en/custom-curtains/">tailored to measure</a>, for living rooms, majlis and diwaniya, from ceiling to floor; <a class="text-gold-deep underline" href="/en/roller-blinds/">roller blinds</a> for bedrooms, kitchens, bathrooms and offices; <a class="text-gold-deep underline" href="/en/blackout-curtains/">blackout curtains</a> for bedrooms and windows that face the afternoon sun; and <a class="text-gold-deep underline" href="/en/zebra-blinds/">zebra blinds</a>, <a class="text-gold-deep underline" href="/en/wooden-blinds/">wooden blinds</a>, <a class="text-gold-deep underline" href="/en/sheer-curtains/">sheer curtains</a>, <a class="text-gold-deep underline" href="/en/kids-blinds/">printed kids’ blinds</a> and <a class="text-gold-deep underline" href="/en/office-blinds/">office blinds</a>.
        </p>
        <p>
          For offices, schools and embassies see <a class="text-gold-deep underline" href="/en/commercial-curtains/">commercial curtains</a>. See all rates in our <a class="text-gold-deep underline" href="/en/curtain-prices/">curtain price list</a>, or read our <a class="text-gold-deep underline" href="/en/blog/">curtain guides</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 md:py-16" aria-labelledby="areas-title">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <div>
        <h2 id="areas-title" class="text-2xl md:text-3xl font-bold text-charcoal">Areas we serve</h2>
        <p class="mt-3 leading-8 text-charcoal/75">All six governorates of Kuwait: Capital, Hawalli, Farwaniya, Ahmadi, Mubarak Al-Kabeer and Jahra.</p>
      </div>
      <ul class="divide-y divide-charcoal/15 border-y border-charcoal/15">
        {areas.map((a) => (
          <li><a href={a.href} class="flex items-center justify-between gap-4 py-4 text-lg font-semibold text-charcoal hover:text-gold-deep">{a.name}<span aria-hidden="true" class="text-gold-deep">›</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-14 md:pb-16">
    <h2 class="text-2xl font-bold text-charcoal mb-6">FAQ</h2>
    <FAQ faqs={faqs} />
  </section>

  <section class="bg-ink text-center">
    <div class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="text-2xl md:text-3xl font-bold text-white">Send us your window size</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/75 leading-8">
        We reply on WhatsApp with an initial quote. Prefer a call or a visit? <a href="/en/contact/" class="underline text-gold">Contact us</a>.
      </p>
      <WhatsAppButton label="Get a quote on WhatsApp" placement="footer-cta" class="mt-7 px-8 py-3.5 text-lg" />
    </div>
  </section>
</BaseLayout>

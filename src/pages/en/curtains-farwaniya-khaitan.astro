---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Picture } from "astro:assets";
import img from "../../content/projects/images/roll-grey-three-windows-1.jpg";
// F3 المرحلة 2: صفحة منطقة إنجليزية فقط (بلا مقابل عربي). «نخدم» المنطقة؛ لا تُنسب لها أعمال لم تُنفَّذ فيها.
const faqs = [{"question": "Do you come to Farwaniya and Khaitan?", "answer": "Yes. We cover Farwaniya and Khaitan and the rest of Kuwait, and the measurement visit with fabric samples is free in Farwaniya and Khaitan."}, {"question": "How much do curtains cost in Farwaniya and Khaitan?", "answer": "Prices are the same everywhere in Kuwait, per square metre: sheers 5 KWD, roller, wave and blackout 6 KWD, wave with sheer 7 KWD, zebra 9 KWD, wooden blinds 13 KWD. Installation is free for orders of 5 curtains or more; below that it is 5 KWD per curtain."}, {"question": "Can I message you in English?", "answer": "Yes, we speak English. Send a photo of your window and its size on WhatsApp in English and we reply with an initial quote."}, {"question": "What is the most affordable option?", "answer": "Sheer curtains at 5 KWD per m² and roller blinds at 6 KWD per m² are our most affordable options, and installation is free when you order 5 or more."}];
const areaServed = [{"type": "Place", "name": "Farwaniya"}, {"type": "Place", "name": "Khaitan"}, {"type": "Place", "name": "Jleeb Al-Shuyoukh"}, {"type": "Place", "name": "Farwaniya Governorate"}];
---
<BaseLayout title="Curtains Farwaniya & Khaitan" description="Curtains and blinds in Farwaniya, Khaitan and Jleeb Al-Shuyoukh with clear prices per square metre: roller blinds and sheers from 5 KWD, we speak English." schemaType="Service" faqs={faqs} areaServed={areaServed}>
  <article class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal leading-tight">Curtains in Farwaniya and Khaitan</h1>
    <p class="mt-4 text-charcoal/85 leading-8">We serve Farwaniya Governorate, including Farwaniya, Khaitan, Jleeb Al-Shuyoukh, Ardiya and Andalus. Our prices are fixed per square metre and include fabric, track and tailoring, so you can work out the cost of a whole flat before we visit.</p>
    <Picture src={img} alt="Three grey roller blinds on three separate windows above a grey sofa" formats={["avif"]} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(min-width: 800px) 736px, 92vw" quality={60} loading="eager" class="my-6 w-full rounded-2xl" />
    <h2 class="mt-10 text-2xl font-bold text-charcoal">Good-value options</h2>
    <ul class="mt-4 list-disc ps-6 space-y-2 text-charcoal/85 leading-7">
      <li><strong><a class="text-olive underline" href="/en/sheer-curtains/">Sheer curtains</a>:</strong> 5 KWD per m² for light and daytime privacy.</li>
      <li><strong><a class="text-olive underline" href="/en/roller-blinds/">Roller blinds</a>:</strong> 6 KWD per m², one blind per window for a tidy look.</li>
      <li><strong><a class="text-olive underline" href="/en/blackout-curtains/">Blackout roller blinds</a>:</strong> 6 KWD per m² for bedrooms.</li>
    </ul>
    <p class="mt-4 text-charcoal/85 leading-8">Example: a window of 1.5 × 1.5 m (2.25 m²) with a roller blind costs about 13.5 KWD. With 5 blinds or more, installation is free. See the full <a class="text-olive underline" href="/en/curtain-prices/">price list</a>.</p>

    <h2 class="mt-10 text-2xl font-bold text-charcoal">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (<div><p class="font-semibold text-charcoal">{f.question}</p><p class="mt-1 text-charcoal/80 leading-7">{f.answer}</p></div>))}
    </div>
    <div class="mt-10"><WhatsAppButton label="Get a quote on WhatsApp" /></div>
  </article>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Picture } from "astro:assets";
import img from "../../content/projects/images/capital-zebra-black-bedroom-1.jpg";
// F3 المرحلة 2: صفحة منطقة إنجليزية فقط (بلا مقابل عربي). «نخدم» المنطقة؛ لا تُنسب لها أعمال لم تُنفَّذ فيها.
const faqs = [{"question": "Do you come to Kuwait City?", "answer": "Yes. We cover Kuwait City and the rest of Kuwait, and the measurement visit with fabric samples is free in Kuwait City."}, {"question": "How much do curtains cost in Kuwait City?", "answer": "Prices are the same everywhere in Kuwait, per square metre: sheers 5 KWD, roller, wave and blackout 6 KWD, wave with sheer 7 KWD, zebra 9 KWD, wooden blinds 13 KWD. Installation is free for orders of 5 curtains or more; below that it is 5 KWD per curtain."}, {"question": "Can I message you in English?", "answer": "Yes, we speak English. Send a photo of your window and its size on WhatsApp in English and we reply with an initial quote."}, {"question": "Do you fit blinds for offices and clinics in the city?", "answer": "Yes. We split wide glass fronts into several roller or zebra blinds so each section is adjusted on its own; installation is free for 5 blinds or more."}];
const areaServed = [{"type": "Place", "name": "Kuwait City"}, {"type": "Place", "name": "Sharq"}, {"type": "Place", "name": "Capital Governorate"}];
---
<BaseLayout title="Curtains Kuwait City title="Curtains Kuwait City — Homes, Offices" Sharq" description="Curtains and blinds in Kuwait City, Sharq and the Capital Governorate for apartments, offices and clinics: made to measure, free visit, we speak English." schemaType="Service" faqs={faqs} areaServed={areaServed}>
  <article class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal leading-tight">Curtains and Blinds in Kuwait City</h1>
    <p class="mt-4 text-charcoal/85 leading-8">We tailor curtains and blinds across Kuwait City and the Capital Governorate, including Sharq, Dasman, Bneid Al-Gar and the residential areas around the city centre: apartments, villas, offices and clinics.</p>
    <Picture src={img} alt="Black zebra blind with open stripes letting daylight in, in a bedroom in the Capital Governorate" formats={["avif"]} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(min-width: 800px) 736px, 92vw" quality={60} loading="eager" class="my-6 w-full rounded-2xl" />
    <h2 class="mt-10 text-2xl font-bold text-charcoal">Our recent work in the Capital Governorate</h2>
    <ul class="mt-4 list-disc ps-6 space-y-2 text-charcoal/85 leading-7">
      <li>Two grey zebra blinds for a paediatric clinic, giving daylight and privacy during check-ups.</li>
      <li>A black zebra blind for a bedroom, with stripes that open for daylight and close for privacy.</li>
      <li>Beige wave curtains with white sheers across a full living room wall.</li>
      <li>Brown wooden blinds over a wide kitchen window, and a white roller blind for a bathroom with a garden view.</li>
    </ul>
    <p class="mt-4 text-charcoal/85 leading-8">See photos on our <a class="text-olive underline" href="/areas/capital/">Capital Governorate page</a> (in Arabic). For offices and clinics see <a class="text-olive underline" href="/en/office-blinds/">office blinds</a> and <a class="text-olive underline" href="/en/zebra-blinds/">zebra blinds</a>.</p>

    <h2 class="mt-10 text-2xl font-bold text-charcoal">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (<div><p class="font-semibold text-charcoal">{f.question}</p><p class="mt-1 text-charcoal/80 leading-7">{f.answer}</p></div>))}
    </div>
    <div class="mt-10"><WhatsAppButton label="Get a quote on WhatsApp" /></div>
  </article>
</BaseLayout>

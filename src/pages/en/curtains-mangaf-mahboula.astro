---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Picture } from "astro:assets";
import img from "../../content/projects/images/blackout-wave-beige-sheer-bedroom-1.jpg";
// F3 المرحلة 2: صفحة منطقة إنجليزية فقط (بلا مقابل عربي). «نخدم» المنطقة؛ لا تُنسب لها أعمال لم تُنفَّذ فيها.
const faqs = [{"question": "Do you come to Mangaf and Mahboula?", "answer": "Yes. We cover Mangaf and Mahboula and the rest of Kuwait, and the measurement visit with fabric samples is free in Mangaf and Mahboula."}, {"question": "How much do curtains cost in Mangaf and Mahboula?", "answer": "Prices are the same everywhere in Kuwait, per square metre: sheers 5 KWD, roller, wave and blackout 6 KWD, wave with sheer 7 KWD, zebra 9 KWD, wooden blinds 13 KWD. Installation is free for orders of 5 curtains or more; below that it is 5 KWD per curtain."}, {"question": "Can I message you in English?", "answer": "Yes, we speak English. Send a photo of your window and its size on WhatsApp in English and we reply with an initial quote."}, {"question": "Which fabric holds up best near the sea?", "answer": "Synthetic fabrics such as polyester keep their colour longer in strong sun and are easier to look after than cotton or linen. A blackout or lining layer also protects the front fabric from fading."}];
const areaServed = [{"type": "Place", "name": "Mangaf"}, {"type": "Place", "name": "Mahboula"}, {"type": "Place", "name": "Fintas"}, {"type": "Place", "name": "Abu Halifa"}, {"type": "Place", "name": "Fahaheel"}, {"type": "Place", "name": "Ahmadi Governorate"}];
---
<BaseLayout title="Curtains Mangaf & Mahboula" description="Curtains and blinds in Mangaf, Mahboula, Fintas, Abu Halifa and Fahaheel, made to measure for apartments: blackout, sheers and roller blinds, we speak English." schemaType="Service" faqs={faqs} areaServed={areaServed}>
  <article class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal leading-tight">Curtains in Mangaf, Mahboula and Fahaheel</h1>
    <p class="mt-4 text-charcoal/85 leading-8">We serve the coastal apartment towers and villas of Ahmadi Governorate: Mangaf, Mahboula, Fintas, Abu Halifa and Fahaheel. Many of our customers here have just moved into a new flat and want every window covered quickly, so we measure in one visit, tailor everything together and install in 2 to 3 days.</p>
    <Picture src={img} alt="Beige wave blackout curtain beside a white sheer on a hidden ceiling track in a bedroom" formats={["avif"]} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(min-width: 800px) 736px, 92vw" quality={60} loading="eager" class="my-6 w-full rounded-2xl" />
    <h2 class="mt-10 text-2xl font-bold text-charcoal">A simple plan for a new apartment</h2>
    <ul class="mt-4 list-disc ps-6 space-y-2 text-charcoal/85 leading-7">
      <li><strong>Bedrooms:</strong> <a class="text-olive underline" href="/en/blackout-curtains/">blackout curtains</a> or blackout roller blinds (6 KWD per m²) for sleep.</li>
      <li><strong>Living room:</strong> <a class="text-olive underline" href="/en/wave-curtains/">wave curtains with sheer</a> (7 KWD per m²) for daylight and evening privacy.</li>
      <li><strong>Kitchen and bathroom:</strong> <a class="text-olive underline" href="/en/roller-blinds/">roller blinds</a> (6 KWD per m²).</li>
      <li><strong>Kids’ room:</strong> <a class="text-olive underline" href="/en/kids-blinds/">printed kids’ blinds</a>.</li>
    </ul>
    <p class="mt-4 text-charcoal/85 leading-8">Ordering 5 curtains or more makes installation free, which usually covers a whole apartment. Example: a two-bedroom flat with 6 windows of about 3 m² each in blackout roller blinds is 18 m² × 6 = 108 KWD, installation included.</p>

    <h2 class="mt-10 text-2xl font-bold text-charcoal">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (<div><p class="font-semibold text-charcoal">{f.question}</p><p class="mt-1 text-charcoal/80 leading-7">{f.answer}</p></div>))}
    </div>
    <div class="mt-10"><WhatsAppButton label="Get a quote on WhatsApp" /></div>
  </article>
</BaseLayout>

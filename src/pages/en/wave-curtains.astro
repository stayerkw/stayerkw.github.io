---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import { Picture } from "astro:assets";
import img from "../../content/projects/images/hawalli-wave-beige-sheer-tall-window-1.jpg";
const faqs = [{"question": "What are wave curtains?", "answer": "Curtains that hang from a special track in soft, identical S-shaped folds. The track sets the spacing, so the folds stay even whether the curtain is open or closed."}, {"question": "How much do wave curtains cost?", "answer": "6 KWD per m² for a single layer, 7 KWD per m² with a sheer on a double track, and 9 KWD per m² for blackout with sheer. Installation is free for orders of 5 curtains or more; below that it is 5 KWD per curtain."}, {"question": "Can the track be hidden in the ceiling?", "answer": "Yes. Wave tracks fit inside gypsum ceiling recesses and cornices, which hides the track and stops light leaking from the top."}];
---
<BaseLayout title="Wave Curtains Kuwait — Ceiling Tracks" description="Wave curtains in Kuwait made to measure: even S-shaped folds on a ceiling track, with or without sheers or blackout, from 6 KWD per square metre." schemaType="Service" faqs={faqs}>
  <article class="mx-auto max-w-3xl px-4 py-10" lang="en" dir="ltr">
    <h1 class="text-4xl font-bold text-charcoal leading-tight">Wave Curtains in Kuwait</h1>
    <p class="mt-4 text-charcoal/85 leading-8">Wave curtains are the most requested style in Kuwaiti homes today: soft, even folds from ceiling to floor on a track that can be hidden in the gypsum ceiling. They suit wide living rooms, majlis and diwaniya walls, and tall windows.</p>
    <Picture src={img} alt="White sheer and beige wave curtain on hidden ceiling tracks beside a tall window" formats={["avif"]} fallbackFormat="webp" widths={[400, 640, 900]} sizes="(min-width: 800px) 736px, 92vw" quality={60} loading="eager" class="my-6 w-full rounded-2xl" />
    <h2 class="mt-10 text-2xl font-bold text-charcoal">Options</h2>
    <ul class="mt-4 list-disc ps-6 space-y-2 text-charcoal/85 leading-7">
      <li><strong>Wave curtain:</strong> 6 KWD per m².</li>
      <li><strong>Wave with sheer (double track):</strong> sheer for the day, fabric for the evening. 7 KWD per m².</li>
      <li><strong>Wave blackout:</strong> 6 KWD per m² single layer, or 9 KWD per m² with a sheer.</li>
      <li><strong>Eyelet curtains:</strong> rings on a visible rod if you prefer that look. 6 KWD per m².</li>
    </ul>
    <p class="mt-4 text-charcoal/85 leading-8">Our recent wave projects include a full living room wall in Kuwait City, a two-wall diwaniya and a double-height staircase window in Hawalli. Combine wave curtains with <a class="text-olive underline" href="/en/sheer-curtains/">sheer curtains</a>, or see the full <a class="text-olive underline" href="/en/curtain-prices/">price list</a>. The home visit to measure and show samples is free, except in Abdali and Subiya.</p>

    <h2 class="mt-10 text-2xl font-bold text-charcoal">FAQ</h2>
    <div class="mt-4 space-y-4">
      {faqs.map((f) => (<div><p class="font-semibold text-charcoal">{f.question}</p><p class="mt-1 text-charcoal/80 leading-7">{f.answer}</p></div>))}
    </div>
    <div class="mt-10"><WhatsAppButton label="Get a quote on WhatsApp" /></div>
  </article>
</BaseLayout>

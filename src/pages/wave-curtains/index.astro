---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import FAQ from "../../components/FAQ.astro";
import { frontmatter, Content } from "../../data/pages/wave.md";
import { priceList, installRule } from "../../data/pricing";

const fm = frontmatter as {
  title: string; description: string; h1: string; intro: string;
  faqs: { question: string; answer: string }[];
};

const products = (await getCollection("products", ({ data }) => !data.draft))
  .filter((p) => p.data.curtainType === "wave")
  .sort((a, b) => a.data.order - b.data.order);

// أسعار الويفي من مصدر الأسعار الواحد (د.ك للمتر المربع).
const priceOf = (id: string) => priceList.find((r) => r.id === id)?.price;
const wavePrice = priceOf("wave");
const khaamPrice = priceOf("wave-sheer");
const waveBlackoutPrice = priceOf("wave-blackout");
const khaamBlackoutPrice = priceOf("khaam-blackout");
---
<BaseLayout
  title={fm.title}
  description={fm.description}
  schemaType="Service"
  serviceType="تفصيل وتركيب ستائر ويفي مع شيفون"
  faqs={fm.faqs}
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <Breadcrumbs
      items={[
        { label: "الرئيسية", href: "/" },
        { label: "أنواع الستائر", href: "/curtains/" },
        { label: "ستائر ويفي مع شيفون" },
      ]}
    />
    <h1 class="text-3xl md:text-4xl font-bold leading-tight text-charcoal mb-4">{fm.h1}</h1>
    <p class="text-lg text-charcoal/80 leading-8 mb-6">{fm.intro}</p>
    <WhatsAppButton label="اطلب عرض سعر لستائر الويفي" topic="wave" class="mb-12" />

    <div class="prose prose-lg max-w-none prose-a:text-gold-deep mb-12">
      <Content />
    </div>

    {wavePrice !== undefined && khaamPrice !== undefined && (
      <>
        <h2 class="text-2xl font-bold text-charcoal mb-3">كم سعر ستائر الويفي؟</h2>
        <p class="leading-8 text-charcoal/80 mb-12">
          تبدأ ستائر الويفي من {wavePrice} د.ك للمتر المربع، وعند دمجها مع الشيفون («الخام») {khaamPrice} د.ك، والويفي مع بلاك أوت بطبقة واحدة {waveBlackoutPrice} د.ك، والخام بلاك أوت مع شيفون {khaamBlackoutPrice} د.ك. والتركيب مجاني عند طلب {installRule.freeFrom} ستائر فأكثر، وأقل من ذلك يُضاف {installRule.fee} د.ك لتركيب كل ستارة.
          أرسل مقاس نافذتك عبر واتساب لعرض سعر مبدئي، أو قدّره من
          <a href="/prices/" class="text-gold-deep underline">حاسبة الأسعار</a>.
        </p>
      </>
    )}

    {products.length > 0 && (
      <>
        <h2 class="text-2xl font-bold text-charcoal mb-4">نماذج من ستائر الويفي</h2>
        <div class="grid gap-5 sm:grid-cols-2 mb-12">
          {products.map((product, i) => (
            <a href={`/products/${product.id}/`} class="group block overflow-hidden rounded-2xl bg-white ring-1 ring-sand hover:shadow-lg transition-shadow">
              {product.data.image && (
                <Picture formats={["avif"]} fallbackFormat="webp" widths={[360, 480, 600]} sizes="(min-width: 1024px) 480px, (min-width: 640px) 46vw, 92vw" quality={55}
                  src={product.data.image}
                  alt={product.data.imageAlt ?? product.data.title}
                  width={600}
                  height={800}
                  loading={i < 2 ? "eager" : "lazy"}
                  class="aspect-[3/4] w-full object-cover"
                />
              )}
              <div class="p-4">
                <h3 class="font-bold text-charcoal">{product.data.title}</h3>
                <p class="mt-1 text-sm text-charcoal/75 line-clamp-2">{product.data.description}</p>
                {product.data.price !== undefined && (
                  <p class="mt-2 text-sm font-semibold text-olive">من {product.data.price} د.ك للمتر المربع</p>
                )}
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    <h2 class="text-2xl font-bold text-charcoal mb-3">تفصيل وتركيب في كل المحافظات</h2>
    <p class="leading-8 text-charcoal/80 mb-12">
      نركّب ستائر الويفي في العاصمة وحولي والفروانية ومبارك الكبير والأحمدي والجهراء. راجع
      <a href="/services/tailoring/" class="text-gold-deep underline">خدمة التفصيل</a>،
      و<a href="/services/installation/" class="text-gold-deep underline">خدمة التركيب</a>،
      و<a href="/areas/" class="text-gold-deep underline">مناطق التغطية</a>.
      وللمزيد عن النوع وخياراته وأسعاره: <a href="/curtains/wave/" class="text-gold-deep underline">ستائر ويفي الكويت</a>، وللحجب شبه الكامل: <a href="/curtains/blackout/" class="text-gold-deep underline">ستائر بلاك أوت</a>.
      وإن كنت تفضّل الرول: <a href="/ready-roll-curtains/" class="text-gold-deep underline">ستائر رول جاهزة</a>.
    </p>

    <h2 class="text-2xl font-bold text-charcoal mb-4">أسئلة شائعة عن ستائر الويفي</h2>
    <FAQ faqs={fm.faqs} />

    <div class="mt-12 text-center">
      <WhatsAppButton label="أرسل مقاس نافذتك واحصل على عرض سعر" />
    </div>
  </div>
</BaseLayout>

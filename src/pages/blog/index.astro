---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Card from "../../components/Card.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title="أعمالنا ومقالات" description="مقالات وأعمال منجزة في تفصيل وتركيب الستائر في الكويت.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs items={[{ label: "الرئيسية", href: "/" }, { label: "أعمالنا" }]} />
    <h1 class="text-3xl font-bold text-charcoal mb-8">أعمالنا ومقالات</h1>
    {posts.length === 0 ? (
      <p class="text-charcoal/60">لا توجد مقالات منشورة بعد.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <Card title={post.data.title} description={post.data.description} href={`/blog/${post.id}/`} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

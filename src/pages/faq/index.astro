---
import { priceList, priceSummary, installRule } from "../../data/pricing";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQ from "../../components/FAQ.astro";

const faqs = [
  {
    question: "كم يستغرق تفصيل وتركيب الستارة؟",
    answer: "مدة التنفيذ المعتادة يومان إلى 3 أيام حسب الكمية.",
  },
  {
    question: "هل الزيارة المنزلية وأخذ المقاسات مجانية؟",
    answer: "نعم، نرسل مندوباً إلى منزلك لأخذ المقاسات على الطبيعة وعرض العينات عليك، والزيارة وأخذ المقاسات مجانية في كل المناطق عدا العبدلي والصبية في محافظة الجهراء، فالمعاينة فيهما مدفوعة. لتحديد موعد الزيارة أرسل لنا عبر واتساب.",
  },
  {
    question: "ما الفرق بين البلاك أوت والرول؟",
    answer: "البلاك أوت يحجب الضوء بالكامل تقريباً، بينما الرول يمنحك تحكماً تدريجياً بكمية الضوء الداخل.",
  },
  {
    question: "ماذا يشمل سعر الستارة؟",
    answer: `السعر شامل القماش والسكة والتفصيل. وتُحسب الأسعار بالمتر المربع وتبدأ من: ${priceSummary(priceList.map((r) => r.id))}. والتركيب لكل الأنواع مجاني عند ${installRule.freeFrom} ستائر فأكثر، وأقل من ذلك ${installRule.fee} د.ك لكل ستارة.`,
  },
  {
    question: "ما مصدر الأقمشة؟",
    answer: "نعمل بأقمشة تركية.",
  },
  {
    question: "هل يوجد ضمان على الستائر؟",
    answer: "نعم، الضمان يوم واحد ويشمل إعادة إصلاح العيوب. الضمان لا يشمل إرجاع الطلب.",
  },
  {
    question: "كيف أطلب عرض سعر؟",
    answer: "أرسل لنا صورة النافذة والمقاس التقريبي عبر واتساب وسنرد عليك بعرض سعر مبدئي.",
  },
  {
    question: "هل تغطون كل مناطق الكويت؟",
    answer: "نعم، نخدم جميع مناطق الكويت دون استثناء، في المحافظات الست: العاصمة، حولي، الفروانية، مبارك الكبير، الأحمدي، والجهراء.",
  },
];
---
<BaseLayout title="الأسئلة الشائعة" description="إجابات عن أكثر الأسئلة شيوعاً حول تفصيل وتركيب الستائر في الكويت: مدة التنفيذ والزيارة المنزلية والضمان والمناطق." schemaType="FAQPage" faqs={faqs}>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <Breadcrumbs items={[{ label: "الرئيسية", href: "/" }, { label: "الأسئلة الشائعة" }]} />
    <h1 class="text-3xl font-bold text-charcoal mb-8">الأسئلة الشائعة</h1>
    <FAQ faqs={faqs} />
  </div>
</BaseLayout>

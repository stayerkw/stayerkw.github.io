---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Card from "../../components/Card.astro";

const products = (await getCollection("products", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout title="منتجات الستائر" description="تصفح منتجات الستائر المتوفرة لدينا في الكويت بجميع الأنواع والمقاسات.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <Breadcrumbs items={[{ label: "الرئيسية", href: "/" }, { label: "المنتجات" }]} />
    <h1 class="text-3xl font-bold text-charcoal mb-8">منتجاتنا</h1>
    {products.length === 0 ? (
      <p class="text-charcoal/60">لا توجد منتجات منشورة بعد.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product, i) => (
          <Card
            title={product.data.title}
            description={product.data.description}
            href={`/products/${product.id}/`}
            image={product.data.image}
            imageAlt={product.data.imageAlt}
            priority={i === 0}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

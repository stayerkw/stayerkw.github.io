---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) => !data.draft);
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// رابط داخلي رجوعاً لصفحة نوع الستارة إن كان محدداً في المنتج
const curtainType = entry.data.curtainType
  ? (await getCollection("curtainTypes", ({ id }) => id === entry.data.curtainType))[0]
  : undefined;
---
<BaseLayout title={entry.data.title} description={entry.data.description} schemaType="Product" price={entry.data.price}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs
      items={[
        { label: "الرئيسية", href: "/" },
        { label: "المنتجات", href: "/products/" },
        { label: entry.data.title },
      ]}
    />
    {entry.data.image && (
      <Image
        src={entry.data.image}
        alt={entry.data.imageAlt ?? entry.data.title}
        width={900}
        height={675}
        loading="eager"
        fetchpriority="high"
        class="w-full rounded-2xl mb-8 object-cover"
      />
    )}
    <h1 class="text-3xl font-bold text-charcoal mb-2">{entry.data.title}</h1>
    {entry.data.price && (
      <p class="text-xl font-semibold text-olive mb-6">
        {entry.data.price} د.ك {entry.data.priceNote && <span class="text-sm text-charcoal/50">({entry.data.priceNote})</span>}
      </p>
    )}
    <div class="prose prose-neutral max-w-none prose-headings:text-charcoal">
      <Content />
    </div>
    <div class="mt-10">
      <WhatsAppButton label={`اطلب ${entry.data.title} الآن`} />
    </div>
    {curtainType && (
      <p class="mt-6 text-sm text-charcoal/60">
        من نوع
        <a href={`/curtains/${curtainType.id}/`} class="text-olive underline hover:text-charcoal">
          {curtainType.data.title}
        </a>
      </p>
    )}
  </article>
</BaseLayout>

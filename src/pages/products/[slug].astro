---
import { getCollection, render } from "astro:content";
import { Picture, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import ProductOrderInfo from "../../components/ProductOrderInfo.astro";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) => !data.draft);
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// صورة المنتج نفسها تصبح og:image وصورة الـ schema (بدل الصورة الافتراضية العامة)،
// فتظهر صورة المنتج عند مشاركة الرابط في واتساب وفي نتائج جوجل.
const ogImage = entry.data.image
  ? (await getImage({ src: entry.data.image, width: 1200, height: 630, fit: "cover", format: "jpg" })).src
  : undefined;

const gallery = entry.data.gallery ?? [];

// مواصفات اختيارية (I1): تُعرض فقط ما عبّأه المالك فعلاً — لا قيم افتراضية
const specs = [
  entry.data.fabricType ? ["نوع القماش", entry.data.fabricType] : null,
  entry.data.opacity ? ["الشفافية", entry.data.opacity] : null,
  entry.data.colors?.length ? ["الألوان المتاحة", entry.data.colors.join("، ")] : null,
  entry.data.care ? ["العناية والتنظيف", entry.data.care] : null,
].filter(Boolean) as string[][];

// رابط داخلي رجوعاً لصفحة نوع الستارة إن كان محدداً في المنتج
const curtainType = entry.data.curtainType
  ? (await getCollection("curtainTypes", ({ id }) => id === entry.data.curtainType))[0]
  : undefined;
---
<BaseLayout title={entry.data.seoTitle ?? entry.data.title} description={entry.data.description} noindex={entry.data.noindex} schemaType="Product" price={entry.data.price} ogImage={ogImage} waTopic="product" waProduct={entry.data.title}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs
      items={[
        { label: "الرئيسية", href: "/" },
        { label: "المنتجات", href: "/products/" },
        { label: entry.data.title },
      ]}
    />
    {entry.data.image && (
      <Picture formats={["avif"]} fallbackFormat="webp" widths={[400, 600, 900]} sizes="(min-width: 480px) 448px, 92vw" quality={55}
        src={entry.data.image}
        alt={entry.data.imageAlt ?? entry.data.title}
        width={900}
        height={1200}
        loading="eager"
        fetchpriority="high"
        class="mx-auto mb-8 aspect-[3/4] w-full max-w-md rounded-2xl object-cover"
      />
    )}
    {gallery.length > 0 && (
      <ul class="grid grid-cols-3 gap-3 mb-8">
        {gallery.map((img, i) => (
          <li>
            <Picture formats={["avif"]} fallbackFormat="webp" widths={[200, 300, 400]} sizes="(min-width: 768px) 240px, 30vw" quality={55}
              src={img}
              alt={`${entry.data.imageAlt ?? entry.data.title} — صورة ${i + 2}`}
              width={400}
              height={533}
              loading="lazy"
              class="aspect-[3/4] w-full rounded-xl object-cover"
            />
          </li>
        ))}
      </ul>
    )}
    <h1 class="text-3xl font-bold text-charcoal mb-2">{entry.data.title}</h1>
    {entry.data.price ? (
      <p class="text-xl font-semibold text-olive mb-6">
        من {entry.data.price} د.ك {entry.data.priceNote && <span class="text-sm text-charcoal/50">({entry.data.priceNote})</span>}
      </p>
    ) : entry.data.priceNote ? (
      <p class="text-xl font-semibold text-olive mb-6">{entry.data.priceNote}</p>
    ) : null}
    <div class="prose prose-neutral max-w-none prose-headings:text-charcoal">
      <Content />
    </div>
    {specs.length > 0 && (
      <dl class="mt-8 grid gap-3 rounded-2xl border border-sand bg-white p-5 text-sm sm:grid-cols-2">
        {specs.map(([k, v]) => (
          <div>
            <dt class="text-charcoal/50">{k}</dt>
            <dd class="font-semibold text-charcoal">{v}</dd>
          </div>
        ))}
      </dl>
    )}
    <ProductOrderInfo price={entry.data.price} />
    <div class="mt-10">
      <WhatsAppButton label={`اطلب ${entry.data.title} الآن`} topic="product" product={entry.data.title} />
    </div>
    {curtainType && (
      <p class="mt-6 text-sm text-charcoal/60">
        من نوع
        <a href={`/curtains/${curtainType.id}/`} class="text-olive underline hover:text-charcoal">
          {curtainType.data.title}
        </a>
      </p>
    )}
  </article>
</BaseLayout>
